# ==============================================================================
# SUPABASE STORAGE (destino principal de las fotos subidas desde la app)
# ==============================================================================
# Las fotos se guardan en el bucket público "anuncios", dentro de propuesta/.
# Si están definidas, /api/upload sube aquí primero y usa Drive solo si falla.
#
# La service_role key está en Supabase → Project Settings → API Keys
# (pestaña "Legacy API keys" → service_role, o una "Secret key" sb_secret_...).
# Es SECRETA: solo en .env.local y en Vercel, nunca con prefijo VITE_.
#
# SUPABASE_URL=https://hnfuzeqkilhtnnaodkwy.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# CONFIGURACIÓN DE GOOGLE DRIVE (OPCIONAL PERO RECOMENDADA)
# ==============================================================================
# Con Drive conectado, el álbum muestra TODAS las fotos de tu carpeta de Drive:
# las que se suben desde la app y las que subas directo a la carpeta (app de
# Drive del celular, drive.google.com, etc.), junto con los recuerdos locales.
#
# Si dejas todo vacío, la app funciona igual guardando las fotos en el navegador
# (IndexedDB), pero solo se ven en ese dispositivo.
#
# En local copia este archivo como .env.local; en producción ponlas en
# Vercel → Settings → Environment Variables y vuelve a desplegar.
#
# Elige UNA opción:

# ------------------------------------------------------------------------------
# OPCIÓN A (RECOMENDADA con Gmail personal): Google Apps Script
# ------------------------------------------------------------------------------
# Ver/subir fotos sin Google Cloud Console. Instrucciones completas en
# google-apps-script/Code.gs. La carpeta debe estar compartida como
# "Cualquier persona con el enlace · Lector".
# GOOGLE_DRIVE_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

# ------------------------------------------------------------------------------
# OPCIÓN B: Google Service Account (la carpeta puede ser privada)
# ------------------------------------------------------------------------------
# 1. En Google Cloud Console (https://console.cloud.google.com) crea un proyecto.
# 2. Habilita la "Google Drive API".
# 3. Crea una "Cuenta de Servicio" y descarga la clave en JSON.
# 4. Comparte tu carpeta de Drive con el correo de la cuenta de servicio.
#
# Importante: con Gmail personal la cuenta de servicio puede VER las fotos pero
# NO subirlas (no tiene cuota de almacenamiento; solo funciona con Unidades
# compartidas de Workspace). Si quieres ver con esta opción y subir desde la app,
# configura también GOOGLE_DRIVE_WEBHOOK_URL (la subida usa el webhook primero).
#
# GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-servicio@tu-proyecto.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASC...\n-----END PRIVATE KEY-----\n"
# GOOGLE_DRIVE_FOLDER_ID=1a2B3c4D5e6F7g8H9i0JkLmNoPqRsTuVw

# ------------------------------------------------------------------------------
# OPCIÓN C: Solo ver (sin subir desde la app) con API key
# ------------------------------------------------------------------------------
# Carpeta compartida "Cualquier persona con el enlace" + API key de Google Cloud
# con la Drive API habilitada. Las fotos se suben directo desde Drive.
#
# GOOGLE_API_KEY=AIza...
# GOOGLE_DRIVE_FOLDER_ID=1a2B3c4D5e6F7g8H9i0JkLmNoPqRsTuVw
